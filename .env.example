# Optional overrides. Dashboard works without these variables.
# Default Dashboard password: vortex110 (change before exposing it publicly)
DASHBOARD_PASSWORD=vortex110
# If omitted, a random secret is created and saved in data/session-secret.
SESSION_SECRET=
# Optional AppState JSON array; safer to enter it in the Dashboard.
APPSTATE_JSON=
# Optional comma-separated Messenger admin IDs
ADMIN_IDS=
# Optional display overrides
PREFIX=*
BOT_NAME=VORTEX
PORT=3000
NODE_ENV=development
